# Sanity CMS connection.
# These two values are safe to expose publicly (they identify the project and
# dataset; they are NOT secrets). Copy this file to `.env.local` for local dev,
# and set the SAME two variables in Vercel → Project Settings → Environment
# Variables for production.
NEXT_PUBLIC_SANITY_PROJECT_ID=h0xv92n1
NEXT_PUBLIC_SANITY_DATASET=production

# Live US market news (homepage "US Market News" section).
# OPTIONAL: leave this unset and the site falls back to Yahoo Finance's public
# RSS headlines (no key required), so live news works out of the box.
# For richer headlines (summaries, images, source names), create a FREE API
# token at https://finnhub.io/ (Dashboard → API key) and set it below. This is
# a SERVER-ONLY secret — do NOT prefix it with NEXT_PUBLIC_. In production, set
# the same variable in Vercel → Project Settings → Environment Variables.
FINNHUB_API_KEY=
